pipeline {
    agent any

    environment {
        DOCKER_USERNAME = credentials('Docker-User')
        DOCKER_PASSWORD = credentials('Docker-Password')
        DOCKER_IMAGE = "orabi20/jenkins-app-lab34:${BUILD_NUMBER}"
        K8S_API_SERVER = credentials('api-server')
        K8S_TOKEN = credentials('token')
    }

    stages {

        stage('Run Tests') {
            steps {
                dir('Jenkins/Lab34_pipeline') {
                    sh 'mvn test'
                }
            }
        }

        stage('Build Application') {
            steps {
                dir('Jenkins/Lab34_pipeline') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Jenkins/Lab34_pipeline') {
                    sh """
                        docker build -t ${DOCKER_IMAGE} .
                        docker tag ${DOCKER_IMAGE} orabi20/jenkins-app-lab34:latest
                    """
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    sh """
                        echo "${DOCKER_PASSWORD}" | docker login -u "${DOCKER_USERNAME}" --password-stdin
                        docker push ${DOCKER_IMAGE}
                        docker push orabi20/jenkins-app-lab34:latest
                        docker logout
                    """
                }
            }
        }

        stage('Cleanup Local Images') {
            steps {
                sh """
                    docker rmi ${DOCKER_IMAGE} || true
                    docker rmi ${DOCKER_USERNAME}/jenkins-app-lab34:latest || true
                """
            }
        }
    }
}
